# =============================================================================
# Recommendations admin (existing module) -- Prisma
# =============================================================================
# SQLite for local dev. Swap for a postgresql:// URL in prod (schema.prisma
# provider must match).
DATABASE_URL="file:./dev.db"

# MVP single-admin auth for the recommendations module.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# =============================================================================
# Paper trading + replay module -- Supabase
# =============================================================================
# Project URL and PUBLISHABLE key. Both are safe to expose to the browser.
# Find them under Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ and never import it into a
# client component -- src/lib/supabase/admin.ts is marked `server-only` so the
# build fails if you try. It is used solely by the CSV import route to write
# shared market data, which is read-only to every browser client by design.
# Leave blank if you do not need CSV import.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/seed-paper-trading.mjs to attribute demo data.
SEED_USER_EMAIL=

# =============================================================================
# Wave Lab market data -- Zerodha
# =============================================================================
# Which provider /api/market/* uses. Unset or `auto` walks the chain below and
# takes the first one that is configured: Kite MCP, then a local bridge, then
# Kite Connect REST. Pin one explicitly with kite-mcp | bridge | kite-rest |
# synthetic.
MARKET_PROVIDER=auto

# --- Option 1: Zerodha Kite MCP (preferred) ---------------------------------
# The MCP endpoint holding your Kite session. Zerodha's hosted server, or a
# local bridge. Tools are discovered at runtime, so an argument rename upstream
# does not break the integration. Read-only: the provider refuses to call any
# tool whose name looks like an order path.
KITE_MCP_URL=
# Bearer token, if your endpoint wants one.
KITE_MCP_TOKEN=
# Extra headers as a JSON object, e.g. {"X-Session":"..."}
KITE_MCP_HEADERS=

# --- Option 2: a local bridge in front of Kite ------------------------------
# Keeps the API secret out of this app entirely. Expected endpoints are
# documented in src/lib/market/providers/bridge.ts.
ZERODHA_BRIDGE_URL=
ZERODHA_BRIDGE_HEADERS=

# --- Option 3: Kite Connect REST with a proper login ------------------------
# The API key AND secret enable the in-app sign-in: the chart sends you to
# Zerodha, Zerodha returns a request_token, and the app swaps it for an access
# token. Tokens die at the next pre-open (about 06:00 IST), so this is a
# once-a-day step rather than a one-off.
#
# KITE_REDIRECT_URL must match the redirect URL registered on your Kite
# developer console EXACTLY, or the login lands somewhere unexpected.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=http://localhost:3040/api/kite/callback
KITE_API_URL=https://api.kite.trade

# Optional: paste a token to skip the sign-in. Overrides anything stored.
KITE_ACCESS_TOKEN=

# Where the access token is kept when Supabase is not configured. It is a
# credential -- written 0600 and git-ignored. Set to 0 on a read-only or
# multi-instance host and rely on Supabase instead.
KITE_SESSION_FILE=1

# --- Candle storage: Supabase ------------------------------------------------
# Reuses the paper-trading project's `instruments` and `market_candles` tables.
# Bars fetched from Zerodha are cached here and served back when current, which
# keeps the chart off Kite's rate limits and keeps it working when the token
# expires. Needs the two NEXT_PUBLIC_SUPABASE_* vars above plus a bridge key.
#
# The bridge key gates the narrow import/read functions rather than handing this
# app the service-role key. Create it once with:
#   insert into bridge.api_keys (name, key_hash)
#   values ('kite-console', extensions.crypt('<your key>', extensions.gen_salt('bf')))
#   on conflict (name) do update set key_hash = excluded.key_hash;
SUPABASE_BRIDGE_KEY=

# Set to 0 in production so a misconfigured provider fails loudly instead of
# quietly drawing generated prices. Default (1) keeps the workspace usable with
# no credentials, flagged as simulated throughout the UI.
MARKET_ALLOW_SYNTHETIC=1
