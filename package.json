{
  "name": "indiacharts-admin",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:icon": "node scripts/make-icon.mjs",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:win": "npm run desktop:prepare && electron-builder --win --x64 --publish never --config electron-builder.config.js",
    "desktop:pack": "electron-builder --win --x64 --publish never --config electron-builder.config.js",
    "desktop:linux": "npm run desktop:prepare && electron-builder --linux --publish never --config electron-builder.config.js",
    "dev": "node scripts/with-system-ca.mjs next dev -p 3040",
    "build": "next build",
    "start": "node scripts/with-system-ca.mjs next start -p 3040",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed": "node prisma/seed.mjs",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset && node prisma/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:artifact": "node scripts/build-artifact.mjs",
    "kite:doctor": "node scripts/kite-doctor.mjs",
    "paper:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/lib/supabase/types.ts",
    "paper:migrate": "supabase db push",
    "paper:test": "psql \"$SUPABASE_DB_URL\" -f supabase/tests/engine_tests.sql"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "exceljs": "^3.4.0",
    "lightweight-charts": "5.2.0",
    "lucide-react": "0.454.0",
    "marked": "14.1.3",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright": "^1.49.1",
    "postcss": "8.4.47",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
